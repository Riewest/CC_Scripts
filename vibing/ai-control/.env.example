# Application bind address; 0.0.0.0 allows Docker/LAN access.
AIC_HOST=0.0.0.0
# HTTP port exposed by the app and Docker.
AIC_PORT=8000
# Maximum encoded WebSocket JSON message size before chunking/rejection (128 KiB default).
AIC_MAX_WS_MESSAGE_BYTES=131072
# Seconds allowed for a client to send its initial hello message.
AIC_HELLO_TIMEOUT_S=5
# Server-requested client heartbeat interval in seconds.
AIC_HEARTBEAT_INTERVAL_S=30
# Mark clients offline after this many seconds without a heartbeat.
AIC_HEARTBEAT_TIMEOUT_S=90
# SQLAlchemy URL. SQLite file persists in the Docker data volume.
AIC_DATABASE_URL=sqlite:///./data/aicontrol.db
# development enables debug details; use production when deployed.
AIC_ENVIRONMENT=development
# Allow registration after the first administrator has completed /setup.
AIC_ALLOW_SIGNUP=false
# Optional built frontend directory; empty uses the bundled/default search paths.
AIC_WEB_DIST_DIR=
# URL-safe base64 Fernet key for encrypting AI provider API keys; generate with Fernet.generate_key().
AIC_SECRET_ENCRYPTION_KEY=
