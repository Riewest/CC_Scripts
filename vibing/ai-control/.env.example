# Application bind address; 0.0.0.0 allows Docker/LAN access.
AIC_HOST=0.0.0.0
# HTTP port exposed by the app and Docker.
AIC_PORT=8000
# SQLAlchemy URL. SQLite file persists in the Docker data volume.
AIC_DATABASE_URL=sqlite:///./data/aicontrol.db
# development enables debug details; use production when deployed.
AIC_ENVIRONMENT=development
# Optional built frontend directory; empty uses the bundled/default search paths.
AIC_WEB_DIST_DIR=
# URL-safe base64 Fernet key for encrypting AI provider API keys; generate with Fernet.generate_key().
AIC_SECRET_ENCRYPTION_KEY=
